# TAKE-TUK backend environment template. PLACEHOLDERS ONLY: never commit real values.
# Copy to .env for local development. Full reference: docs/operations/OPERATIONS.md §3.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# json (default; for log aggregation) or text (local reading)
LOG_FORMAT=text
TRUST_PROXY=false
# Serves Swagger UI at /docs. Refused in production.
API_DOCS_ENABLED=true

# Login role that is a MEMBER OF taketuk_api (never the postgres superuser). See OPERATIONS §4.
# Local Supabase CLI: postgres://taketuk_api_local:<password>@127.0.0.1:54322/postgres
# Production must use sslmode=verify-full (or verify-ca) with the Supabase CA certificate.
DATABASE_URL=postgres://taketuk_api_local:change-me@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Supabase project URL. Issuer and JWKS URL are derived from it.
SUPABASE_URL=http://127.0.0.1:54321
# jwks (asymmetric signing keys, preferred) or legacy_hs256 (shared secret; set AUTH_JWT_SECRET).
AUTH_JWT_MODE=jwks
# AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated

# in_memory (development only) or supabase
STORAGE_PROVIDER=in_memory
# Server-side only. Required when STORAGE_PROVIDER=supabase.
# SUPABASE_SECRET_KEY=
STORAGE_DRIVER_DOCUMENTS_BUCKET=driver-documents

# dev_fake (development only; refused in production) or google
ROUTING_PROVIDER=dev_fake
# GOOGLE_MAPS_API_KEY=
ROUTING_TIMEOUT_MS=5000

# log (development only) or fcm
NOTIFICATION_PROVIDER=log
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json

WORKERS_ENABLED=true

# Operational thresholds: DEVELOPMENT DEFAULTS, to be tuned (OPEN_DECISIONS DSP-1).
QUOTE_TTL_SECONDS=600
QUOTE_RATE_LIMIT_PER_MINUTE=10
RIDE_SEARCH_TIMEOUT_SECONDS=300
OFFER_RESPONSE_TIMEOUT_SECONDS=45
COUNTEROFFER_RESPONSE_TIMEOUT_SECONDS=60
DISPATCH_RADIUS_METERS=3000
DISPATCH_BATCH_SIZE=5
DRIVER_LOCATION_MAX_AGE_SECONDS=120
DISPATCH_RETRY_INTERVAL_SECONDS=10
OUTBOX_MAX_ATTEMPTS=8
IDEMPOTENCY_TTL_HOURS=24
